        <div class="detail-box" id="earbuds-details">
            <h3>Wireless Earbuds</h3>
            <p>Category: Smart Device</p>
            <p>Connectivity: Bluetooth</p>
            <p>Features: Microphone and charging case</p>
            <p>Listed Price: ₹1,699</p>
        </div>
