            <article class="product-card">
                <span class="discount">20% OFF</span>
                <img
                    src="https://images.unsplash.com/photo-1609592806596-b43bada3f6f5?auto=format&fit=crop&w=600&q=80"
                    alt="Portable electronic accessory">
                <div class="product-info">
                    <img src="images (12).jpg"class="btn">View Detail</a>
                    <h3>Power Bank</h3>
                    <p class="description">Portable charging for your devices.</p>
