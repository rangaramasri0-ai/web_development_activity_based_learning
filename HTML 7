            <p>Category: Accessories</p>
            <p>Capacity: 20000mAh</p>
            <p>Feature: Fast charging</p>
            <p>Listed Price: ₹1,599</p>
        </div>

        <div class="detail-box" id="watch-details">
            <h3>Smart Watch</h3>
            <p>Category: Smart Device</p>
            <p>Features: Fitness tracking and Bluetooth</p>
            <p>Display: Touchscreen</p>
            <p>Listed Price: ₹3,299</p>
