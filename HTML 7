                    <p class="price">₹59,999 <del>₹74,999</del></p>
                    <a href="#hp-details" class="btn">View Details</a>
                </div>
            </article>

            <article class="product-card">
                <span class="discount">15% OFF</span>
                <img
                    src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=600&q=80"
                    alt="Laptop computer">
                <div class="product-info">
                    <h3>MacBook Air</h3>
                    <p class="description">Lightweight laptop for productivity.</p>
                    <p class="specs">Apple Chip | 16GB RAM | 256GB SSD</p>
                    <p class="price">₹89,999 <del>₹1,05,999</del></p>
                    <a href="#mac-details" class="btn">View Details</a>
                </div>
            </article>

        </div>

        <!-- Smartphones -->
        <h3 class="category-heading" id="phones">📱 Smartphones</h3>
        <div class="product-grid">

            <article class="product-card">
                <span class="discount">10% OFF</span>
                <img
                    src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=600&q=80"
                    alt="Smartphone">
                <div class="product-info">
                    <h3>Samsung Galaxy</h3>
                    <p class="description">Brilliant display and great camera.</p>
                    <p class="specs">8GB RAM | 256GB Storage | 5G</p>
                    <p class="price">₹29,999 <del>₹33,333</del></p>
                    <a href="#samsung-details" class="btn">View Details</a>
                </div>
            </article>

            <article class="product-card">
                <span class="discount">12% OFF</span>
