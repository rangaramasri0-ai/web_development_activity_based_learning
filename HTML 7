                    <p class="price">₹1,599 <del>₹1,999</del></p>
                    <a href="#power-details" class="btn">View Details</a>
                </div>
            </article>

        </div>

        <!-- Smart Devices -->
        <h3 class="category-heading" id="smart">⌚ Smart Devices</h3>
        <div class="product-grid">

            <article class="product-card">
                <span class="discount">18% OFF</span>
                <img
                    src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=600&q=80"
                    alt="Smart watch">
                <div class="product-info">
                    <h3>Smart Watch</h3>
                    <p class="description">Stay connected throughout your day.</p>
                    <p class="specs">Fitness Tracking | Bluetooth | Touchscreen</p>
                    <p class="price">₹3,299 <del>₹4,000</del></p>
                    <a href="#watch-details" class="btn">View Details</a>
                </div>
            </article>

            <article class="product-card">
                <span class="discount">15% OFF</span>
                <img
                    src="https://images.unsplash.com/photo-1608156639585-b3a032ef9689?auto=format&fit=crop&w=600&q=80"
                    alt="Wireless earbuds">
                <div class="product-info">
                    <h3>Wireless Earbuds</h3>
                    <p class="description">Compact earbuds for everyday listening.</p>
                    <p class="specs">Bluetooth | Charging Case | Microphone</p>
                    <p class="price">₹1,699 <del>₹1,999</del></p>
                    <a href="#earbuds-details" class="btn">View Details</a>
                </div>
            </article>

        </div>
