* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    background: #f4f7fb;
    color: #222;
    line-height: 1.6;
}

h2 {
    text-align: center;
    color: #123c69;
    margin-bottom: 25px;
}

section {
    padding: 45px 6%;
}

/* Navigation */
header {
    background: #102a43;
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 6%;
    gap: 20px;
}

.logo {
    color: #ffca28;
    font-size: 27px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 22px;
}

.nav-links a {
    text-decoration: none;
    color: white;
    font-weight: bold;
}

.nav-links a:hover {
    color: #ffca28;
}

.nav-btn,
.btn {
    display: inline-block;
    background: #ff9800;
    color: #172b4d;
    padding: 10px 18px;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
    transition: 0.3s;
}

.nav-btn:hover,
.btn:hover {
    background: #ffca28;
    transform: translateY(-2px);
}

/* Hero Section */
.hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    background: linear-gradient(120deg, #dbeafe, #fef3c7);
    padding: 60px 8%;
}

.hero-text,
.hero-image {
    flex: 1;
}

.tag {
    display: inline-block;
    background: #ff5722;
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: bold;
}

.hero-text h2 {
    text-align: left;
    font-size: 42px;
    margin: 15px 0;
}

.hero-text p {
    margin-bottom: 25px;
    font-size: 18px;
}

.hero-image img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: 18px;
}

/* Categories */
.categories {
    text-align: center;
    background: white;
}

.category-list {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
}

.category-list a {
    padding: 15px 22px;
    background: #e3efff;
    color: #123c69;
    text-decoration: none;
    border-radius: 10px;
    font-weight: bold;
}

.category-list a:hover {
    background: #123c69;
    color: white;
}

/* Special Offers */
.deals {
    text-align: center;
    background: #fff4e5;
}

.deals > p {
    margin-bottom: 20px;
}

.deal-banner {
    max-width: 600px;
    margin: auto;
    padding: 30px;
    border-radius: 15px;
    color: white;
    background: linear-gradient(135deg, #ef6c00, #f9a825);
}

.deal-banner h3 {
    font-size: 32px;
    margin-bottom: 10px;
}

.deal-banner .btn {
    margin-top: 18px;
    background: white;
}

/* Products */
.products {
    background: #f4f7fb;
}

.category-heading {
    color: #123c69;
    font-size: 24px;
    margin: 35px 0 20px;
    padding-bottom: 8px;
    border-bottom: 3px solid #ff9800;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px;
}

.product-card {
    position: relative;
    overflow: hidden;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 15px #102a4315;
    transition: transform 0.3s, box-shadow 0.3s;
}

.product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 22px #102a4325;
}

.product-card > img {
    width: 100%;
    height: 230px;
    object-fit: cover;
}

.discount {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #e53935;
    color: white;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 13px;
    font-weight: bold;
}

.product-info {
    padding: 20px;
}

.product-info h3 {
    color: #123c69;
    font-size: 21px;
    margin-bottom: 8px;
}

.description {
    color: #666;
    margin-bottom: 10px;
}

.specs {
    font-size: 14px;
    background: #edf4ff;
    padding: 10px;
    border-radius: 5px;
    margin-bottom: 12px;
}

.price {
    font-size: 23px;
    font-weight: bold;
    color: #e65100;
    margin: 12px 0;
}

.price del {
    font-size: 15px;
    font-weight: normal;
    color: #888;
    margin-left: 8px;
}

.product-info .btn {
    margin-top: 5px;
}

/* Product Details */
.details {
    background: white;
}

.detail-box {
    background: #f4f7fb;
    border-left: 5px solid #ff9800;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 18px;
    scroll-margin-top: 100px;
}

.detail-box h3 {
    color: #123c69;
    margin-bottom: 10px;
}

.detail-box p {
    padding: 3px 0;
}

/* Comparison Table */
.comparison {
    background: #eaf2ff;
}

.table-container {
    width: 100%;
    overflow-x: auto;
    background: white;
    border-radius: 10px;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 480px;
}

th,
td {
    border: 1px solid #d6deea;
    padding: 14px;
    text-align: center;
}

th {
    background: #123c69;
    color: white;
}

tbody tr:nth-child(even) {
    background: #f0f5fc;
}

tbody tr:hover {
    background: #fff0d6;
}

/* Footer */
footer {
    background: #102a43;
    color: white;
    text-align: center;
    padding: 30px 15px;
}

footer h2 {
    color: #ffca28;
}

footer p {
    margin: 8px 0;
}

/* Tablet */
@media (max-width: 850px) {
    .navbar {
        flex-wrap: wrap;
        justify-content: center;
    }

    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
    }

    .hero-text h2 {
        font-size: 32px;
    }
}

/* Mobile */
@media (max-width: 600px) {
    .navbar {
        flex-direction: column;
        padding: 15px;
    }

    .nav-links {
        gap: 12px;
    }

    .nav-links a {
        font-size: 14px;
    }

    .nav-btn {
        display: none;
    }

    .hero {
        flex-direction: column;
        padding: 35px 20px;
        text-align: center;
    }

    .hero-text h2 {
        text-align: center;
        font-size: 30px;
    }

    .hero-image img {
        height: 230px;
    }

    section {
        padding: 35px 20px;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .category-list {
        flex-direction: column;
    }

    .deal-banner h3 {
        font-size: 26px;
    }
}
